[binaries]
c = ['x86_64-w64-mingw32-gcc', '-B/work/prefix/lib/']
cpp = ['x86_64-w64-mingw32-g++', '-B/work/prefix/lib/']
ar = 'x86_64-w64-mingw32-ar'
strip = 'x86_64-w64-mingw32-strip'
windres = 'x86_64-w64-mingw32-windres'
pkg-config = 'pkg-config'

[host_machine]
system = 'windows'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
needs_exe_wrapper = true

[built-in options]
c_args = ['-I/work/prefix/include']
cpp_args = ['-I/work/prefix/include']
c_link_args = ['-L/work/prefix/lib']
cpp_link_args = ['-L/work/prefix/lib']
