target/
launcher/gen/schemas/
disk.img

# Bundled QEMU sidecars/libs and firmware, fetched by .github/scripts/ (see
# README); never checked in. The .gitkeep placeholders are kept so the
# tauri.conf.json `bundle.resources` globs still match on a fresh clone
# before those scripts have run.
launcher/binaries/
launcher/firmware/*
!launcher/firmware/.gitkeep
launcher/qemu-libs/*
!launcher/qemu-libs/.gitkeep
